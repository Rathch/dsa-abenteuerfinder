# IMAGE für Compose (app / scheduler / public-init).
#
# Server flach: /opt/apps/dsa-abenteuerfinder/.env (ohne Unterordner deploy/)
# Lokal aus deploy/: hier kopieren oder docker compose --env-file ../.env …
#
# Zusätzlich benötigt (Laravel, Produktion):
#   APP_NAME=DSA-Abenteuerfinder
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_KEY=base64:…            (php artisan key:generate --show)
#   APP_URL=https://dsa-abenteuerfinder.rath-ulrich.de
#   APP_LOCALE=de
#   DB_CONNECTION=sqlite
#   DB_DATABASE=/var/lib/dsa-abenteuerfinder/database.sqlite
#   ADMIN_PASSWORD_HASH=…      (bcrypt; ohne Wert ist /verwaltung 404)

IMAGE=ghcr.io/rathch/dsa-abenteuerfinder:latest
